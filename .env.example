# Embedding mode must be single-model and fixed-dimension.
# Use exactly one active model per environment.
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSION=1536
LOCAL_EMBEDDING_MODEL_ID=BAAI/bge-large-en-v1.5

# SQLAlchemy/Alembic URLs
DATABASE_URL_ASYNC=postgresql+asyncpg://grimoire_admin:grimoire_secure_password@localhost:5432/grimoire_core
DATABASE_URL_SYNC=postgresql+psycopg://grimoire_admin:grimoire_secure_password@localhost:5432/grimoire_core

# Optional OpenAI-compatible endpoint used by the application layer.
# Keep unset for default provider endpoints.
EMBEDDING_API_BASE_URL=
