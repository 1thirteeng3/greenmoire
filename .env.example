# ==========================================
# GRIMOIRE COGNITIVE OS - AMBIENTE BASE
# ==========================================

# --- INFRAESTRUTURA DE DADOS ---
DATABASE_URL=postgresql+psycopg2://grimoire_admin:grimoire_secure_password@localhost:5432/grimoire_core
REDIS_URL=redis://localhost:6379/0
OBSIDIAN_VAULT_PATH=./2ndBrain

# CRITICO: bge-large exige 1024 dimensoes. (OpenAI usa 1536).
# O pgvector usara este valor ao instanciar as tabelas.
EMBEDDING_DIMENSION=1024

# --- MOTOR DE EMBEDDINGS (LocalAI) ---
# Alinhado com o docker-compose.yml (LocalAI roda na 8080)
EMBEDDING_API_BASE=http://localhost:8080/v1
EMBEDDING_API_KEY=sk-localai-dummy
EMBEDDING_MODEL=bge-large

# --- MOTOR VLM & LLM ORQUESTRADOR ---
VLM_PROVIDER=openai
VLM_BASE_URL=https://api.openai.com/v1
VLM_API_KEY=sua_chave_openai_aqui
VLM_MODEL_NAME=gpt-4o-mini

# ==========================================
# MOTOR DE INFERENCIA E ROTEAMENTO (FASE 4)
# ==========================================
ANTHROPIC_API_KEY=sua_chave_anthropic_aqui

# Tier 1 (Direct/Rapido): Ideal para LocalAI (Custo Zero, Privacidade) ou GPT-4o-mini
ROUTER_T1_PROVIDER=localai
ROUTER_T1_MODEL=llama-3-8b-instruct

# Tier 2 (Analytical/RAG): Exige boa janela de contexto e raciocinio rapido
ROUTER_T2_PROVIDER=openai
ROUTER_T2_MODEL=gpt-4o-mini

# Tier 3 (Complex/Agentic): Exige raciocinio de estado da arte
ROUTER_T3_PROVIDER=anthropic
ROUTER_T3_MODEL=claude-3-5-sonnet-latest

# --- INTEGRACOES DE INGESTAO ---
FIRECRAWL_API_KEY=sua_chave_firecrawl
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v1
OPENDATALOADER_URL=http://localhost:8000

# ==========================================
# FASE 6: API GATEWAY & SEGURANCA
# ==========================================
API_SECRET_TOKEN=grimoire_super_secret_token_2026
RATE_LIMIT_REQUESTS_PER_MINUTE=20
